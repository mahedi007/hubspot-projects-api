# Required: HubSpot Private App access token (starts with "pat-")
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Optional: Project custom object type id (e.g. 2-12345678).
# If empty, the app looks it up by name ("project") on first use.
HUBSPOT_PROJECT_OBJECT_TYPE=
# Optional
PORT=3000
